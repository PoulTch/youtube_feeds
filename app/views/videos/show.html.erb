<% content_for :title, "#{@video.title} — MyChannels" %>

<div class="player-responsive-container" 
     data-controller="video-player" 
     data-video-player-youtube-id-value="<%= @video.youtube_video_id %>" 
     data-video-player-video-id-value="<%= @video.id %>">

  <style>
    .player-responsive-container {
      max-width: 1200px; 
      margin: 0; 
      padding: 0 16px; 
      box-sizing: border-box; 
      width: 100%;
    }
    @media (min-width: 1400px) {
      .player-responsive-container {
        margin: 0 auto;
      }
    }
    
    /* УМНЫЙ ДВУХРЕЖИМНЫЙ КОНТЕЙНЕР ДЛЯ ПОЛНОГО СИНХРОНА НА ПК */
    .video-main-layout-box {
      display: flex;
      flex-direction: column;
      gap: 24px;
      width: 100%;
    }

    /* УМНЫЙ КОНТЕЙНЕР ПЛЕЕРА + ФЛЕКС-ЦЕНТРИРОВАНИЕ ДЛЯ ANDROID */
    .video-player-wrapper {
      width: 100%;
      aspect-ratio: <%= @video.video_type == 'shorts' ? '9/16' : '16/9' %>; 
      background: #000;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,0.15);
      flex-shrink: 0;
      position: relative;
      
      /* ВНЕДРЕНО: Превращаем контейнер во флекс-бокс, который намертво центрирует всё внутри */
      display: flex;
      align-items: center;     /* Центрирование по вертикали (убьет пустоту на Realme!) */
      justify-content: center; /* Центрирование по горизонтали */
    }
    
    /* ЖЕЛЕЗОБЕТОННОЕ ВЫРАВНИВАНИЕ IFRAME ДЛЯ ВСЕХ МОБИЛОК */
    .video-player-wrapper iframe {
      width: 100%;
      height: 100%;
      border: none;
      display: block;
      
      /* Для Realme убираем абсолютный сдвиг, флекс-бокс выше сделает всё сам плавно и ровно */
      margin: 0;
    }

    /* ТЕКСТОВЫЙ БЛОК */
    .video-info-block {
      width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
    }

    /* --- ЭКСКЛЮЗИВНЫЕ ДЕСКТОПНЫЕ МЕТРИКИ ДЛЯ ШОРТСОВ (Плеер слева, инфа справа) --- */
    @media (min-width: 768px) {
      <% if @video.video_type == 'shorts' %>
        .video-main-layout-box {
          flex-direction: row !important; 
          align-items: flex-start;
        }
        .video-player-wrapper {
          width: auto !important;
          height: 75vh !important; 
          aspect-ratio: 9/16 !important;
        }
        .shorts-info-column {
          flex-grow: 1;
          padding-left: 10px;
        }
      <% end %>
    }
  </style>

  <!-- ГЛАВНЫЙ МАКЕТ СТРАНИЦЫ -->
  <div class="video-main-layout-box">
    
    <!-- СНОВА В ИГРЕ СЛЕВА: ПЛЕЕР -->
    <div class="video-player-wrapper">
      <iframe 
        id="youtube-player"
        src="https://www.youtube.com/embed/<%= @video.youtube_video_id %>?autoplay=1&rel=0&enablejsapi=1&playsinline=1" 
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
        allowfullscreen>
      </iframe>
    </div>

    <!-- СНОВА В ИГРЕ СПРАВА / СНИЗУ: БЛОК ИНФОРМАЦИИ -->
    <div class="video-info-block">
      <h1 class="video-title" style="margin: 0 0 12px 0; font-size: 1.4rem; font-weight: bold; color: #0f0f0f; line-height: 1.3;">
        <%= @video.title %>
      </h1>

      <!-- НОВОЕ ОПИСАНИЕ В СТИЛЕ YOUTUBE (С КЛИКОМ ДЛЯ РАЗВЕРТЫВАНИЯ) -->
      <% if @video.description.present? %>
        <div class="video-description-box" onclick="toggleDescription(this)">
          <div class="video-stats-inline">
            <%= number_to_human(@video.views_count, locale: :ru) if @video.views_count.to_i > 0 %> просмотров 
            <% if @video.likes_count.to_i > 0 %>
              <span>•</span> 👍 <%= number_to_human(@video.likes_count, locale: :ru) %> 
            <% end %>
            <span>•</span> 
            <%= @video.published_at.strftime("%d.%m.%Y") if @video.published_at %>
          </div>

          <div class="video-description-text" id="desc-text">
            <%= @video.description %>
          </div>
          <span class="more-btn" id="more-btn">...еще</span>
        </div>
      <% end %>

      <!-- БЛОК АВТОРСТВА -->
      <div class="video-meta-block" style="margin-top: 20px;">
        <a href="<%= channel_page_path(@video.channel) %>" style="text-decoration: none; display: flex; align-items: center; gap: 10px; color: #ff0000; font-weight: bold; font-size: 1.1rem; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
          <% if @video.channel.avatar_url.present? %>
            <img src="<%= @video.channel.avatar_url %>" alt="" class="micro-avatar" style="width: 36px; height: 36px; flex-shrink: 0; border-radius: 50%; object-fit: cover;">
          <% else %>
            <span style="font-size: 1.3rem;">🔴</span>
          <% end %>
          <%= @video.channel.title %>
        </a>
      </div>

    </div>
  </div>

  <!-- ОБЪЕДИНЕННЫЙ ИНТЕЛЛЕКТУАЛЬНЫЙ СКРИПТ: Время просмотра, автоповорот и описание -->
  <script>
    // 1. УПРАВЛЕНИЕ ВРЕМЕНЕМ ПРОСМОТРА И ОРИДЖИНОМ ПЛЕЕРА
    (function() {
      const videoId = "<%= @video.youtube_video_id %>";
      let savedTime = parseFloat(localStorage.getItem(videoId)) || 0;
      const durationSeconds = parseInt("<%= @video.duration_seconds || 0 %>", 10);
      
      if (durationSeconds > 0 && savedTime >= durationSeconds) {
        savedTime = 0;
        localStorage.setItem(videoId, 0);
      }

      const iframe = document.getElementById("youtube-player");
      if (iframe) {
        const currentOrigin = window.location.origin;
        iframe.src = "https://www.youtube.com/embed/" + videoId + "?autoplay=1&rel=0&enablejsapi=1&playsinline=1&origin=" + encodeURIComponent(currentOrigin) + "&start=" + Math.round(savedTime);
      }

      document.removeEventListener("turbo:visit", window.handleTurboBackRefresh);
      
      window.handleTurboBackRefresh = function(event) {
        if (event.detail.action === "restore") {
          Turbo.cache.clear();
          setTimeout(() => { window.location.reload(); }, 50);
        }
      };

      document.addEventListener("turbo:visit", window.handleTurboBackRefresh);
    })();

    // 2. РАСКРЫТИЕ И СВЕРТЫВАНИЕ ОПИСАНИЯ РОЛИКА
    function toggleDescription(block) {
      const text = document.getElementById('desc-text');
      const btn = document.getElementById('more-btn');
      
      block.classList.toggle('expanded');
      
      if (block.classList.contains('expanded')) {
        btn.innerText = 'Свернуть';
      } else {
        btn.innerText = '...еще';
      }
    }

    // 3. УМНЫЙ АВТОПОВОРОТ НА ПОЛНЫЙ ЭКРАН С УЧЕТОМ ТИПА РОЛИКА (SHORTS / VIDEO)
    document.addEventListener("fullscreenchange", function() {
      const videoType = "<%= @video.video_type %>"; // Узнаем тип ролика напрямую из Rails!

      if (document.fullscreenElement) {
        if (screen.orientation && screen.orientation.lock) {
          if (videoType === 'shorts') {
            // ЖЕСТКО БЛОКИРУЕМ ШОРТСЫ В ВЕРТИКАЛЬНОМ РЕЖИМЕ НА МОБИЛКЕ!
            screen.orientation.lock("portrait").catch(function(error) {
              console.log("Портретный поворот заблокирован системой:", error);
            });
          } else {
            // Обычные видео и стримы крутим горизонтально, как и раньше
            screen.orientation.lock("landscape").catch(function(error) {
              console.log("Горизонтальный поворот заблокирован системой:", error);
            });
          }
        }
      } else {
        // При выходе из полного экрана возвращаем свободу поворота
        if (screen.orientation && screen.orientation.unlock) {
          screen.orientation.unlock();
        }
      }
    });
  </script>
</div>
