<!-- ШАПКА ПЛЕЙЛИСТА (ОБЪЕДИНЕННАЯ) -->
<div style="max-width: 1200px; margin: 0 auto 20px auto; padding: 20px 16px 0 16px; display: flex; align-items: flex-start; gap: 24px; border-bottom: 1px solid #e8e8e8; padding-bottom: 24px; flex-wrap: wrap;">
  
  <!-- КНОПКА ВОЗВРАТА СТРОГО НА ВКЛАДКУ ПЛЕЙЛИСТОВ -->
  <!-- ЭЛЕГАНТНЫЙ ВНУТРЕННИЙ КОМПАС (БЕЗ ВИЗУАЛЬНОГО ШУМА) -->
  <div style="width: 100%; margin-bottom: 12px;">
    <a href="<%= channel_page_path(@channel, tab: 'playlists') %>" 
       style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px; color: #606060; font-size: 0.95rem; font-weight: 500; transition: color 0.2s;"
       onmouseover="this.style.color='#0f0f0f'" 
       onmouseout="this.style.color='#606060'">
      <svg viewBox="0 0 24 24" style="width: 18px; height: 18px; fill: currentColor; display: block;"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
      Назад к плейлистам
    </a>
  </div>

    <div style="flex: 1; min-width: 300px;">
    <h1 style="margin: 0 0 4px 0; font-size: 2rem; font-weight: bold; color: #0f0f0f;">Сборник: <%= @playlist.title %></h1>
    <p style="margin: 0 0 16px 0; color: #606060; font-size: 0.95rem;">
      Автор: <strong style="color: #ff0000;"><%= @channel.title %></strong> • Всего видео на YouTube: <strong><%= @playlist.video_count || 0 %></strong> • В локальной базе: <strong><%= @videos.size %></strong>
    </p>

    <!-- ПАНЕЛЬ КНОПОК УПРАВЛЕНИЯ ПЛЕЙЛИСТОМ (УМНАЯ + С ПОДТВЕРЖДЕНИЕМ) -->
    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
      
      <% if @videos.any? %>
        <!-- Если ролики уже в базе — выводим легкую серую кнопку обновления -->
        <%= button_to sync_playlist_videos_path(@playlist),
                      method: :post,
                      local: true,
                      data: { turbo: false },
                      form: { onsubmit: "return confirm('Ролики этого плейлиста уже загружены. Вы действительно хотите повторно синхронизировать данные с YouTube API?');" },
                      style: "background: #f2f2f2; color: #0f0f0f; border: 1px solid #ccc; padding: 10px 20px; border-radius: 20px; font-weight: bold; cursor: pointer; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s;",
                      onmouseover: "this.style.background='#e6e6e6'",
                      onmouseout: "this.style.background='#f2f2f2'" do %>
          Обновить плейлист
        <% end %>

        <!-- КНОПКА ОЧИСТКИ ПАМЯТИ СЕРВЕРА -->
        <%= button_to clear_playlist_videos_path(@playlist),
                      method: :post,
                      local: true,
                      data: { turbo: false },
                      form: { onsubmit: "return confirm('Вы уверены, что хотите удалить все ролики этого плейлиста из локальной базы?');" },
                      style: "background: #fff; color: #cc0000; border: 1px solid #cc0000; padding: 10px 20px; border-radius: 20px; font-weight: bold; cursor: pointer; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s;",
                      onmouseover: "this.style.background='#fff5f5'",
                      onmouseout: "this.style.background='#fff'" do %>
          Удалить плейлист
        <% end %>

      <% else %>
        <!-- Если плейлист девственно пуст — горит полноценная черная ракета запуска -->
        <%= button_to sync_playlist_videos_path(@playlist),
                      method: :post,
                      local: true,
                      data: { turbo: false },
                      form: { onsubmit: "return confirm('Запустить быструю синхронизацию элементов плейлиста через YouTube API?');" },
                      style: "background: #0f0f0f; color: #ffffff; border: none; padding: 10px 20px; border-radius: 20px; font-weight: bold; cursor: pointer; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); transition: background 0.2s;",
                      onmouseover: "this.style.background='#333333'",
                      onmouseout: "this.style.background='#0f0f0f'" do %>
          Синхронизировать с YouTube API
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<!-- БЛОК ПЕРЕКЛЮЧЕНИЯ ХРОНОЛОГИИ ВНУТРИ ПЛЕЙЛИСТА -->
<div style="display: flex; gap: 12px; margin-bottom: 24px; max-width: 1200px; margin-left: auto; margin-right: auto; padding: 0 16px;">
  
  <!-- Тег: Сначала Новые -->
  <a href="<%= playlist_page_path(@playlist, sort: 'desc') %>" 
     style="text-decoration: none; padding: 6px 14px; border-radius: 8px; font-size: 0.9rem; font-weight: bold; transition: background 0.2s, color 0.2s;
            background: <%= @current_sort == 'desc' ? '#0f0f0f' : '#f2f2f2' %>; 
            color: <%= @current_sort == 'desc' ? '#ffffff' : '#0f0f0f' %>;"
     onmouseover="if('<%= @current_sort %>' !== 'desc') this.style.background='#e6e6e6'"
     onmouseout="if('<%= @current_sort %>' !== 'desc') this.style.background='#f2f2f2'">
    Сначала новые
  </a>

  <!-- Тег: Сначала Старые -->
  <a href="<%= playlist_page_path(@playlist, sort: 'asc') %>" 
     style="text-decoration: none; padding: 6px 14px; border-radius: 8px; font-size: 0.9rem; font-weight: bold; transition: background 0.2s, color 0.2s;
            background: <%= @current_sort == 'asc' ? '#0f0f0f' : '#f2f2f2' %>; 
            color: <%= @current_sort == 'asc' ? '#ffffff' : '#0f0f0f' %>;"
     onmouseover="if('<%= @current_sort %>' !== 'asc') this.style.background='#e6e6e6'"
     onmouseout="if('<%= @current_sort %>' !== 'asc') this.style.background='#f2f2f2'">
    Сначала старые
  </a>

</div>

<!-- СЕТКА КАРТОЧЕК ПЛЕЙЛИСТА -->
<div style="max-width: 1200px; margin: 0 auto; padding: 0 16px; margin-bottom: 60px;">
  <% if @videos.any? %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
      <% @videos.each do |video| %>
        <div style="background: #ffffff; border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.01)'" onmouseout="this.style.transform='scale(1)'">
          
          <a href="<%= watch_video_path(video) %>" title="<%= video.title %>" style="position: relative; display: block; overflow: hidden; border-radius: 12px;">
            <% if video.thumbnail_url.present? %>
              <img src="<%= video.thumbnail_url %>" alt="" style="width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block;">
            <% else %>
              <div style="width: 100%; aspect-ratio: 16/9; background: #e0e0e0; display: flex; align-items: center; justify-content: center; color: #888;">Нет превью</div>
            <% end %>
            
            <!-- УМНАЯ ПЛАШКА ВРЕМЕНИ И АНОНСОВ ДЛЯ ПЛЕЙЛИСТОВ С ЗАЩИТОЙ ОТ ПРИЗРАКОВ -->
            <% is_fresh_announcement = video.published_at.present? && (video.published_at > 7.days.ago || video.published_at.to_time > Time.now) %>
            <% is_upcoming_announcement = (video.respond_to?(:video_type) && video.video_type == 'stream' && (video.duration_seconds.to_i == 0 || video.views_count.nil?) && is_fresh_announcement) || (video.published_at.present? && video.published_at.to_time > Time.now) %>
            
            <% if is_upcoming_announcement %>
              <div style="position: absolute; bottom: 8px; right: 8px; background: #cc0000; color: #fff; padding: 3px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: bold; z-index: 5; letter-spacing: 0.5px;">
                СКОРО
              </div>
            <% elsif video.duration_seconds.to_i > 0 %>
              <div style="position: absolute; bottom: 8px; right: 8px; background: rgba(0, 0, 0, 0.8); color: #fff; padding: 3px 6px; border-radius: 4px; font-size: 0.75rem; font-weight: bold; font-family: monospace; z-index: 5;">
                <%= Time.at(video.duration_seconds).utc.strftime(video.duration_seconds >= 3600 ? "%H:%M:%S" : "%M:%S") %>
              </div>
            <% end %>

           <!-- Полоса локального прогресса -->
            <% if video.respond_to?(:watched_seconds) && video.watched_seconds.present? && video.duration_seconds.to_i > 0 %>
              <% progress_percent = (video.watched_seconds.to_f / video.duration_seconds.to_f * 100).clamp(0, 100) %>
              <div style="position: absolute; bottom: 0; left: 0; width: 100%; height: 4px; background: rgba(255,255,255,0.3); z-index: 4;">
                <div style="width: <%= progress_percent %>%; height: 100%; background: #ff0000; transition: width 0.3s;"></div>
              </div>
            <% end %>
          </a>

          <div style="padding: 12px 4px 4px 4px;">
            <h2 style="font-size: 1rem; margin: 0 0 6px 0; line-height: 1.4; max-height: 2.8rem; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
              <a href="<%= watch_video_path(video) %>" style="text-decoration: none; color: #0f0f0f; font-weight: bold;">
                <%= video.title %>
              </a>
            </h2>
            
            <!-- КРАСИВЫЙ СИНХРОН ДАТЫ С ТЕКСТОМ АНОНСА В ПЛЕЙЛИСТЕ -->
            <p style="margin: 0; font-size: 0.8rem; color: #606060;">
              <% if video.published_at.present? %>
                <% if (video.respond_to?(:video_type) && video.video_type == 'stream' && (video.duration_seconds.to_i == 0 || video.views_count.nil?) && is_fresh_announcement) || (video.published_at.to_time > Time.now) %>
                  Скоро (Анонс)
                <% else %>
                  <%= video.published_at.strftime("%d.%m.%Y в %H:%M") %>
                <% end %>
              <% end %>
            </p>

          </div>

        </div>
      <% end %>
    </div>
  <% else %>
    <!-- ДИНАМИЧЕСКАЯ ЗАГЛУШКА С ОБНОВЛЕННЫМ СТИЛЕМ БЕЗ МУСОРА И ЯЩИКОВ -->
    <div style="text-align: center; padding: 60px 20px; color: #606060; background: #f9f9f9; border-radius: 12px; border: 2px dashed #e5e5e5;">
      <p style="margin: 0 0 8px 0; font-weight: bold; color: #0f0f0f; font-size: 1.2rem;">Ролики этого плейлиста ещё не синхронизированы.</p>
      <p style="margin: 0; font-size: 0.95rem; color: #606060; max-width: 500px; margin-left: auto; margin-right: auto; line-height: 1.5;">
        Нажмите чёрную кнопку «Синхронизировать» в шапке, чтобы загрузить актуальный список видеороликов через YouTube API без захламления памяти сервера.
      </p>
    </div>
  <% end %>

</div>

