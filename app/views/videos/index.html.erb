<!-- УМНЫЕ СТИЛИ: На ПК шортсы крупные с текстом снизу, на мобилках — компактные с текстом ПОВЕРХ! -->
<style>
  .main-responsive-container {
    max-width: 1200px; margin: 0; padding: 0 16px; box-sizing: border-box; width: 100%;
  }
  @media (min-width: 1400px) { .main-responsive-container { margin: 0 auto; } }

  /* СЕТКА РОЛИКОВ: По умолчанию (мобилки) шортсы 3 колонки, видео — 1-2 колонки */
  .adaptive-video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(<%= @current_tab == 'shorts' ? '100px' : '240px' %>, 1fr));
    gap: <%= @current_tab == 'shorts' ? '8px' : '20px' %>;
    width: 100%; box-sizing: border-box;
  }

  /* Для Shorts на мобилках прячем стандартный блок и показываем мобильное наложение */
  .shorts-mobile-overlay { display: block; }
  .shorts-desktop-info { display: none; }

  /* --- НАСТРОЙКИ ДЛЯ КОМПЬЮТЕРОВ И НОУТБУКОВ (от 768px и шире) --- */
  @media (min-width: 768px) {
    .adaptive-video-grid {
      grid-template-columns: repeat(auto-fill, minmax(<%= @current_tab == 'shorts' ? '180px' : '240px' %>, 1fr));
      gap: 20px;
    }
    .shorts-mobile-overlay { display: none !important; }
    .shorts-desktop-info { display: block !important; }
  }
</style>

<div class="main-responsive-container">

  <!-- ================= БЛОК: ПРОДОЛЖИТЬ ПРОСМОТР (ИСТОРИЯ) ================= -->
  <% if @history_videos.present? && @history_videos.any? %>
    <div style="margin-bottom: 40px; background: #ffffff; padding: 20px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.02); border: 1px solid #f0f0f0;">
      <h2 style="margin: 0 0 16px 0; font-size: 1.1rem; font-weight: bold; color: #0f0f0f;">Продолжить просмотр</h2>
      <div style="display: flex; gap: 20px; overflow-x: auto; padding-bottom: 10px; scrollbar-width: thin; -webkit-overflow-scrolling: touch;">
        <% @history_videos.each do |video| %>
          <div class="history-card-item" style="flex: 0 0 240px; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 8px rgba(0,0,0,0.04); display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
            <a href="<%= watch_video_path(video) %>" title="<%= video.title %>" style="position: relative; display: block; overflow: hidden;">
              <% if video.thumbnail_url.present? %>
                <img src="<%= video.thumbnail_url %>" alt="" style="width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block;">
              <% else %>
                <div style="width: 100%; aspect-ratio: 16/9; background: #e0e0e0; display: flex; align-items: center; justify-content: center; color: #888; font-size: 0.8rem;">Нет превью</div>
              <% end %>
              <div data-local-progress="<%= video.youtube_video_id %>" style="width: 0%; height: 4px; background: #ff0000; position: relative; margin-top: -4px; z-index: 10; display: block; transition: width 0.3s;"></div>
            </a>
            <div style="padding: 10px 8px 8px 8px;">
              <h3 style="margin: 0 0 6px 0; font-size: 0.85rem; line-height: 1.3; font-weight: bold; max-height: 2.6rem; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                <a href="<%= watch_video_path(video) %>" style="text-decoration: none; color: #0f0f0f;"><%= video.title %></a>
              </h3>
              <p style="margin: 0; font-size: 0.75rem; color: #ff0000; font-weight: bold; display: flex; align-items: center; gap: 6px; overflow: hidden;">
                <% if video.channel.avatar_url.present? %><img src="<%= video.channel.avatar_url %>" alt="" class="micro-avatar" style="width: 14px; height: 14px; flex-shrink: 0; border-radius: 50%; object-fit: cover;"><% end %>
                <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= video.channel.title %></span>
              </p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- ================= БЛОК: ОБЩАЯ ЛЕНТА НОВИНОК ================= -->
  <div class="tabs-container" style="display: flex; gap: 10px; margin-bottom: 25px; border-bottom: 1px solid #e8e8e8; padding-bottom: 12px;">
    <a href="<%= root_path(tab: 'video') %>" style="text-decoration: none; padding: 8px 18px; border-radius: 20px; font-weight: bold; font-size: 0.9rem; transition: all 0.2s; background: <%= @current_tab == 'video' ? '#0f0f0f' : '#f2f2f2' %>; color: <%= @current_tab == 'video' ? '#ffffff' : '#0f0f0f' %>;">Видео</a>
    <a href="<%= root_path(tab: 'shorts') %>" style="text-decoration: none; padding: 8px 18px; border-radius: 20px; font-weight: bold; font-size: 0.9rem; transition: all 0.2s; background: <%= @current_tab == 'shorts' ? '#0f0f0f' : '#f2f2f2' %>; color: <%= @current_tab == 'shorts' ? '#ffffff' : '#0f0f0f' %>;">Shorts</a>
    <a href="<%= root_path(tab: 'stream') %>" style="text-decoration: none; padding: 8px 18px; border-radius: 20px; font-weight: bold; font-size: 0.9rem; transition: all 0.2s; background: <%= @current_tab == 'stream' ? '#0f0f0f' : '#f2f2f2' %>; color: <%= @current_tab == 'stream' ? '#ffffff' : '#0f0f0f' %>;">Трансляции</a>
  </div>

  <div class="adaptive-video-grid">
    <% @videos.each do |video| %>
      <div style="background: #ffffff; border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s; box-shadow: 0 4px 10px rgba(0,0,0,0.02); width: 100%; box-sizing: border-box; position: relative;" onmouseover="this.style.transform='scale(1.01)'" onmouseout="this.style.transform='scale(1)'">
        
        <a href="<%= watch_video_path(video) %>" title="<%= video.title %>" style="position: relative; display: block; overflow: hidden; width: 100%;">
          <% if video.thumbnail_url.present? %>
            <img src="<%= video.thumbnail_url %>" alt="<%= video.title %>" style="width: 100%; aspect-ratio: <%= @current_tab == 'shorts' ? '9/16' : '16/9' %>; object-fit: cover; display: block;">
          <% else %>
            <div style="width: 100%; aspect-ratio: <%= @current_tab == 'shorts' ? '9/16' : '16/9' %>; background: #e0e0e0; display: flex; align-items: center; justify-content: center; color: #888;">Нет превью</div>
          <% end %>

          <!-- МОБИЛЬНОЕ НАЛОЖЕНИЕ ДЛЯ SHORTS (Видно только на мобилках) -->
          <% if @current_tab == 'shorts' %>
            <div class="shorts-mobile-overlay" style="position: absolute; bottom: 4px; left: 0; right: 0; padding: 10px 8px; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 60%, rgba(0,0,0,0) 100%); pointer-events: none;">
              <h3 style="margin: 0 0 2px 0; font-size: 0.75rem; line-height: 1.2; color: #ffffff; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-weight: 500; text-shadow: 0 1px 2px rgba(0,0,0,0.8);">
                <span style="pointer-events: auto; color: #ffffff;"><%= video.title %></span>
              </h3>
              <p style="margin: 0; font-size: 0.65rem; color: #ff4d4d; font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= video.channel.title %></p>
            </div>
          <% end %>
        </a>

        <div data-local-progress="<%= video.youtube_video_id %>" style="width: 0%; height: 4px; background: #ff0000; position: relative; margin-top: -4px; z-index: 10; display: block; transition: width 0.3s;"></div>

        <!-- ДЕСКТОПНЫЙ БЛОК ИНФЫ: На мобилках для Shorts скрывается, для видео виден всегда! -->
        <div class="<%= @current_tab == 'shorts' ? 'shorts-desktop-info' : '' %>" style="padding: 12px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <h3 style="margin: 0 0 8px 0; font-size: 0.9rem; line-height: 1.4; color: #0f0f0f; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-weight: 600;">
              <a href="<%= watch_video_path(video) %>" title="<%= video.title %>" style="text-decoration: none; color: #0f0f0f;"><%= video.title %></a>
            </h3>
            <p style="margin: 0 0 4px 0; font-size: 0.8rem; color: #606060; font-weight: bold; display: flex; align-items: center; gap: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
              <% if video.channel.avatar_url.present? %><img src="<%= video.channel.avatar_url %>" alt="" class="micro-avatar" style="width: 16px; height: 16px; flex-shrink: 0; border-radius: 50%; object-fit: cover;"><% end %>
              <a href="<%= channel_page_path(video.channel) %>" style="text-decoration: none; color: #ff0000; font-weight: bold;"><%= video.channel.title %></a>
            </p>
          </div>
          <div style="margin-top: 8px; font-size: 0.75rem; color: #909090;">
            Опубликовано: <%= video.published_at&.strftime('%d.%m.%Y в %H:%M') || "Скоро" %>
          </div>
        </div>

      </div>
    <% end %>
  </div>

  <div class="youtube-pagination" style="margin-top: 40px; margin-bottom: 60px; display: flex; justify-content: center;"><%== @pagy.series_nav %></div>

</div>
